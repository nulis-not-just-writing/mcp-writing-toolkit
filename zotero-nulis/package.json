{
  "name": "zotero-nulis",
  "version": "0.7.0",
  "private": true,
  "description": "Node.js MCP server for the Zotero reference manager: search, read metadata & full text, browse collections, export BibTeX. Runs on Claude Desktop's built-in Node.js.",
  "license": "CC-BY-NC-4.0",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/index.js --log-level=warning",
    "pack": "npm run build && npx --yes @anthropic-ai/mcpb pack . ../dist/zotero-nulis-0.7.0.mcpb"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.15.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
